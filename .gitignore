# Dependencies
node_modules/

# Build output (regenerated by `npm run build`; installers belong on GitHub Releases)
app/dist/
app/release/
# OCR runtime is staged from node_modules by the prebuild hook
app/public/ocr/

# Packaged apps (published as release assets, never committed)
*.apk
*.exe
*.msi
*.dmg
*.AppImage
*.blockmap

# Android build artifacts and machine-specific config
app/android/.gradle/
app/android/build/
app/android/app/build/
app/android/captures/
app/android/local.properties
app/android/app/src/main/assets/public/
app/android/app/src/main/assets/capacitor.config.json
app/android/app/src/main/assets/capacitor.plugins.json
app/android/app/release/

# Signing material (must never be committed)
*.keystore
*.jks
key.properties
*.p12
*.pem

# Secrets / environment
.env
.env.*

# Logs and OS cruft
*.log
.DS_Store
Thumbs.db

# Claude Code local tooling
.claude/

# Third-party reference screenshots used only during development (not ours to publish)
/*.webp
