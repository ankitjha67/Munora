{
  "name": "nestworth",
  "productName": "Nestworth",
  "version": "0.1.0",
  "description": "Nestworth, a local-first household finance dashboard for Windows",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:web\" \"npm:dev:electron\"",
    "dev:web": "vite",
    "dev:electron": "wait-on http-get://localhost:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "start": "electron .",
    "icon": "node scripts/make-icon.mjs",
    "mobile:assets": "node scripts/make-mobile-assets.mjs && npx --yes @capacitor/assets@3 generate --android --iconBackgroundColor #4F46E5 --splashBackgroundColor #4F46E5",
    "dist": "npm run build && electron-builder --win",
    "cap:sync": "npm run build && cap sync",
    "cap:android": "npm run build && cap sync android && cap open android",
    "cap:ios": "npm run build && cap sync ios && cap open ios",
    "prebuild": "node scripts/copy-ocr-assets.mjs",
    "smoke:electron": "npm run build && electron scripts/smoke-electron.cjs",
    "release": "npm run build && electron-builder --win --publish always",
    "release:draft": "npm run build && electron-builder --win --publish onTagOrDraft",
    "screenshots": "npm run build && electron scripts/screenshots.cjs"
  },
  "dependencies": {
    "@capacitor/app": "^7.1.2",
    "@capacitor/core": "^7.6.9",
    "@capacitor/filesystem": "^7.1.8",
    "@capacitor/status-bar": "^7.0.6",
    "@fontsource-variable/inter": "^5.2.5",
    "d3-sankey": "^0.12.3",
    "imapflow": "^1.7.8",
    "lucide-react": "^0.544.0",
    "pdfjs-dist": "^4.10.38",
    "postal-mime": "^2.7.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.9.1",
    "recharts": "^3.2.0",
    "tesseract.js": "^5.1.1"
  },
  "devDependencies": {
    "@capacitor/android": "^7.6.9",
    "@capacitor/cli": "^7.6.9",
    "@capacitor/ios": "^7.6.9",
    "@tesseract.js-data/eng": "^1.0.0",
    "@types/d3-sankey": "^0.12.4",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "cross-env": "^10.0.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.0.12",
    "sharp": "^0.35.4",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "wait-on": "^8.0.4"
  },
  "build": {
    "appId": "com.nestworth.app",
    "productName": "Nestworth",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    },
    "publish": [
      {
        "provider": "github",
        "releaseType": "release"
      }
    ]
  }
}
